# Copy to .env and fill in. NEVER commit the real .env file.
# Base58-encoded secret key of the devnet-only Candy Machine authority
# keypair, generated by `npm run keypair:generate` — printed to
# candy-machine/.keys/authority-devnet.json (gitignored), not to the console.
AUTHORITY_SECRET_KEY_PATH=.keys/authority-devnet.json
RPC_URL=https://api.devnet.solana.com
