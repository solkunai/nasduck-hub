# Optional: override the default RPC connection (reads only — swaps execute
# via Jupiter's Ultra API, not this connection). Defaults to this project's
# own rpc-proxy edge function — the public Solana RPC returns a flat 403 on
# reads from a real deployed origin (confirmed live), not just a rate
# limit, so it's not a usable fallback. Only set this to point at a
# different RPC entirely.
VITE_RPC_URL=

# Jupiter Referral Program account for fee collection (referral.jup.ag).
# Defaults to REFERRAL_ACCOUNT in src/lib/nasduck.ts if unset — that's the
# real, already-created account for this project's fee wallet. Only set
# this if you need to point at a different referral account (e.g. testing).
VITE_JUP_REFERRAL_ACCOUNT=

# Supabase project backing Phase 2. Defaults to SUPABASE_URL/
# SUPABASE_PUBLISHABLE_KEY in src/lib/nasduck.ts if unset — those are the
# real project values, safe to hardcode since a publishable key is meant to
# be public client-side (never the account's Personal Access Token, a
# completely different, much higher-privilege credential that must never
# appear in frontend code). Only set these to point at a different project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — password for the /mint page's pre-launch gate
# (middleware.ts). Deliberately NOT prefixed with VITE_: that prefix tells
# Vite to bundle a var straight into the public client JS, which would leak
# this password to anyone reading the page source. Set this directly in the
# Vercel project dashboard (Settings → Environment Variables), never in a
# committed file. The middleware fails CLOSED (blocks everyone) if this is
# unset, rather than accidentally leaving /mint open to the public.
MINT_GATE_PASSWORD=

# Turns the /mint buy button on. Leave unset (button reads "MINT OPENS
# SOON") until launch; set to `true` locally to test minting against the
# devnet Candy Machines, and in Vercel only when the real mint goes live.
# Which network/machines the page mints against is decided server-side by
# the nasducks-mint function's secrets, not by this flag.
VITE_MINT_LIVE=

# Required for wallet login/embedded wallets to work at all. From
# dashboard.privy.io — create an app, set the allowed domain to nasduck.wtf
# (+ localhost for dev), and enable Email/Google/Twitter under Login
# Methods. This is the public App ID, not a secret (same trust level as the
# Supabase publishable key above) — safe to commit if you really wanted to,
# but kept as an env var like the others for consistency. With this unset,
# the site still renders but nobody can sign in (see PrivyProviders.tsx).
VITE_PRIVY_APP_ID=
