# Optional: override the default public Solana RPC (reads only — swaps
# execute via Jupiter's Ultra API, not this connection). Only worth setting
# if the public endpoint's own rate limits become a problem.
VITE_RPC_URL=

# Jupiter Referral Program account for fee collection (referral.jup.ag).
# Defaults to REFERRAL_ACCOUNT in src/lib/nasduck.ts if unset — that's the
# real, already-created account for this project's fee wallet. Only set
# this if you need to point at a different referral account (e.g. testing).
VITE_JUP_REFERRAL_ACCOUNT=

# Supabase project backing the wallet PnL feature (Phase 2). The publishable
# key is meant to be public client-side — never put the account's Personal
# Access Token here, that's a completely different, much higher-privilege
# credential that must never appear in frontend code.
VITE_SUPABASE_URL=https://qrqenowwwccmfgwsnfpa.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8in3GY7CIf71OL_PUZv_-Q_JIXeKa4q
