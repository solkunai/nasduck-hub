# Optional: override the default public Solana RPC (reads only — swaps
# execute via Jupiter's Ultra API, not this connection). Only worth setting
# if the public endpoint's own rate limits become a problem.
VITE_RPC_URL=

# Jupiter Referral Program account for fee collection (referral.jup.ag).
# Defaults to FEE_WALLET in src/lib/nasduck.ts if unset — only needs to be
# set explicitly if the referral account address differs from the fee
# wallet itself.
VITE_JUP_REFERRAL_ACCOUNT=
